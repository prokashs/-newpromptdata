# 21. Independent Security Guardrail
# ============================================================

class ExecutionGuardrail:

    def __init__(self):

        self.blocked_patterns = [

            r"rm\s+-rf",

            r"<script>",

            r"eval\(",

            r"Authorization:"
        ]


    def verify_payload(
        self,
        generated_text
    ):

        normalized_text = (
            generated_text.strip()
        )

        for pattern in (
            self.blocked_patterns
        ):

            if re.search(
                pattern,
                normalized_text,
                re.IGNORECASE
            ):

                print(
                    "SECURITY ALERT:",
                    "Guardrail tripped:",
                    pattern
                )

                return False

        return True


