@torch.no_grad()
def predict_animal(
    semantic_model,
    animal
):

    semantic_model.eval()

    animal_id = torch.tensor(
        [animal_to_id[animal]],
        dtype=torch.long,
        device=device
    )

    logits = semantic_model(
        animal_id
    )

    probabilities = F.softmax(
        logits,
        dim=-1
    )

    predicted_id = torch.argmax(
        probabilities,
        dim=-1
    ).item()

    return (
        id_to_verb[predicted_id],
        probabilities[0]
    )


