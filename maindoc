# 15. Semantic Animal Model
# ============================================================
#
# This model explicitly learns:
#
#       animal ID -> correct verb
#
# The embedding values are actual learned neural-network
# parameters.
#
# ============================================================

class AnimalSemanticModel(nn.Module):

    def __init__(
        self,
        num_animals,
        num_verbs,
        embedding_dim=32
    ):

        super().__init__()

        self.animal_embedding = nn.Embedding(
            num_animals,
            embedding_dim
        )

        self.network = nn.Sequential(

            nn.Linear(
                embedding_dim,
                64
            ),

            nn.ReLU(),

            nn.Linear(
                64,
                num_verbs
            )
        )


    def forward(
        self,
        animal_ids
    ):

        x = self.animal_embedding(
            animal_ids
        )

        logits = self.network(
            x
        )

        return logits


# ============================================================
# 16. Train Semantic Model
# ============================================================

def train_semantic_model():

    print("\n========================================")
    print("SEMANTIC MODEL TRAINING")
    print("========================================")

    semantic_model = AnimalSemanticModel(
        num_animals=len(animals),
        num_verbs=len(verbs)
    ).to(device)

    optimizer = torch.optim.AdamW(
        semantic_model.parameters(),
        lr=semantic_learning_rate
    )

    animal_ids = torch.tensor(
        [
            animal_to_id[a]
            for a in animals
        ],
        dtype=torch.long,
        device=device
    )

    target_verb_ids = torch.tensor(
        [
            verb_to_id[
                ANIMAL_SOUNDS[a]["verb"]
            ]

            for a in animals

        ],
        dtype=torch.long,
        device=device
    )

    semantic_model.train()

    for epoch in range(
        semantic_epochs
    ):

        logits = semantic_model(
            animal_ids
        )

        loss = F.cross_entropy(
            logits,
            target_verb_ids
        )

        optimizer.zero_grad()

        loss.backward()

        optimizer.step()

        if epoch % 200 == 0:

            print(
                f"Epoch {epoch:4d} "
                f"| Loss {loss.item():.6f}"
            )

    return semantic_model


